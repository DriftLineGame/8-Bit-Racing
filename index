function optLine(T,w,margin){
  const N=T.N,counts=[];let n=48;while(n<N){counts.push(n);n*=2;}counts.push(N);
  let d=new Float64Array(counts[0]);
  for(let li=0;li<counts.length;li++){
    const m=counts[li],idx=new Int32Array(m);
    for(let i=0;i<m;i++) idx[i]=Math.round(i*N/m)%N;
    const cx=new Float64Array(m),cy=new Float64Array(m),nx=new Float64Array(m),ny=new Float64Array(m),
          hi=new Float64Array(m),lo=new Float64Array(m),px=new Float64Array(m),py=new Float64Array(m);
    for(let i=0;i<m;i++){const j=idx[i];
      cx[i]=T.x[j];cy[i]=T.y[j];nx[i]=T.ty[j];ny[i]=-T.tx[j];
      hi[i]=Math.min(T.mx[j],T.TW-margin);lo[i]=Math.max(T.mn[j],-(T.TW-margin));
      d[i]=clamp(d[i],lo[i],hi[i]);px[i]=cx[i]+nx[i]*d[i];py[i]=cy[i]+ny[i]*d[i];}
    const den=12+4*w;
    for(let it=0;it<600;it++)for(let j=0;j<m;j++){
      const a=(j-1+m)%m,b=(j+1)%m,a2=(j-2+m)%m,b2=(j+2)%m;
      const cAx=px[a2]-2*px[a]+px[j],cAy=py[a2]-2*py[a]+py[j];
      const cJx=px[a]-2*px[j]+px[b],cJy=py[a]-2*py[j]+py[b];
      const cBx=px[j]-2*px[b]+px[b2],cBy=py[j]-2*py[b]+py[b2];
      let g=2*((cAx+cBx-2*cJx)*nx[j]+(cAy+cBy-2*cJy)*ny[j]);
      g+=w*2*(((px[j]-px[a])+(px[j]-px[b]))*nx[j]+((py[j]-py[a])+(py[j]-py[b]))*ny[j]);
      const nd=clamp(d[j]-g/den,lo[j],hi[j]);
      d[j]=nd;px[j]=cx[j]+nx[j]*nd;py[j]=cy[j]+ny[j]*nd;
    }
    if(li<counts.length-1){
      const m2=counts[li+1],nd=new Float64Array(m2);
      for(let i=0;i<m2;i++){const f=i*m/m2,k=f|0,tt=f-k;nd[i]=d[k]*(1-tt)+d[(k+1)%m]*tt;}
      d=nd;
    }
  }
