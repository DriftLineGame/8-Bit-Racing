    this.x=0;this.y=0;this.angle=0;this.vx=0;this.vy=0;this.spin=0;this.hint=-1;
    this.speed=0;this.vf=0;this.vl=0;this.grip=0;this.slip=0;this.onGrass=false;
    this.input={steer:0,throttle:0,brake:0};
    this.laps=-1;this.lapStart=null;this.lapValid=true;this.last=null;this.best=null;this.steerVal=0;
    this.wrong=0;this.stuck=0;this.aimD=0;this.startD=0;this.skill=1;this.bias=0;this.react=0;
    this.finished=false;this.finishTime=null;this.revBlend=0.15;this.gear=1;
  }
  place(T,s,d,sp){
    const p=T.pos(s,d);
    this.x=p.x;this.y=p.y;this.angle=Math.atan2(p.ty,p.tx);
    this.vx=Math.cos(this.angle)*(sp||0);this.vy=Math.sin(this.angle)*(sp||0);
    this.spin=0;this.hint=-1;this.info=T.info(this.x,this.y,-1);this.hint=this.info.i;
    this.prevS=this.info.s;this.aimD=d;this.startD=d;
  }
