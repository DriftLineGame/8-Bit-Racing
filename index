  <div id="overlay"><div class="card" id="card"></div></div>
</div>

<script>
"use strict";
const clamp=(v,a,b)=>v<a?a:(v>b?b:v), lerp=(a,b,t)=>a+(b-a)*t, rnd=(a,b)=>a+Math.random()*(b-a);
function angNorm(a){while(a>Math.PI)a-=6.283185307179586;while(a<-Math.PI)a+=6.283185307179586;return a;}
const D2R=Math.PI/180, STEP=6, ZOOM=0.5, KMH=0.56;
const GEAR_TOPS=[0.13,0.26,0.40,0.56,0.77,1.0];

/* ===================== TRACK ===================== */
class Track{
  constructor(pts,tw,grw,startS,name,label){
    this.name=name;this.label=label;this.TW=tw;this.GRW=grw;this.BAR=tw+grw;
    const N=pts.length;this.N=N;this.LEN=N*STEP;this.startS=startS;
    this.x=new Float64Array(N);this.y=new Float64Array(N);
    for(let i=0;i<N;i++){this.x[i]=pts[i].x;this.y[i]=pts[i].y;}
    this.tx=new Float64Array(N);this.ty=new Float64Array(N);
    this.kap=new Float64Array(N);this.rad=new Float64Array(N);
    this.mx=new Float64Array(N);this.mn=new Float64Array(N);
    for(let i=0;i<N;i++){
      const a=(i-1+N)%N,b=(i+1)%N;
      const dx=this.x[b]-this.x[a],dy=this.y[b]-this.y[a],l=Math.hypot(dx,dy)||1;
      this.tx[i]=dx/l;this.ty[i]=dy/l;
    }
    const K=8;
    for(let i=0;i<N;i++){
      const a=(i-K+N)%N,c=(i+K)%N;
      const th=angNorm(Math.atan2(this.ty[c],this.tx[c])-Math.atan2(this.ty[a],this.tx[a]));
      this.kap[i]=th/(2*K*STEP);
      this.rad[i]=Math.abs(this.kap[i])<1e-7?1e7:1/Math.abs(this.kap[i]);
    }
    for(let i=0;i<N;i++){
      const r=this.rad[i];
      this.mx[i]=this.kap[i]<0?Math.min(this.BAR,0.85*r):this.BAR;
      this.mn[i]=this.kap[i]>0?Math.max(-this.BAR,-0.85*r):-this.BAR;
    }
    this.cs=260;this.grid=new Map();
    for(let i=0;i<N;i++){
      const k=((this.x[i]/this.cs)|0)+","+((this.y[i]/this.cs)|0);
      let a=this.grid.get(k); if(!a){a=[];this.grid.set(k,a);} a.push(i);
    }
    let mnx=1e9,mxx=-1e9,mny=1e9,mxy=-1e9;
    for(let i=0;i<N;i++){mnx=Math.min(mnx,this.x[i]);mxx=Math.max(mxx,this.x[i]);
      mny=Math.min(mny,this.y[i]);mxy=Math.max(mxy,this.y[i]);}
    const M=this.BAR+200;
    this.minX=mnx-M;this.maxX=mxx+M;this.minY=mny-M;this.maxY=mxy+M;
  }
  nearest(x,y){
    const cx=(x/this.cs)|0, cy=(y/this.cs)|0;
    let best=-1,bd=1e18;
    for(let R=1;R<=8;R++){
      for(let a=-R;a<=R;a++)for(let b=-R;b<=R;b++){
        if(R>1&&Math.max(Math.abs(a),Math.abs(b))<R)continue;
        const arr=this.grid.get((cx+a)+","+(cy+b));if(!arr)continue;
        for(let q=0;q<arr.length;q++){const i=arr[q];
          const dx=this.x[i]-x,dy=this.y[i]-y,d=dx*dx+dy*dy;if(d<bd){bd=d;best=i;}}
      }
      if(best>=0&&R>=2)break;
    }
    return best;
  }
  info(x,y,hint){
    const N=this.N;let i=-1;
    if(hint>=0){let bd=1e18;
      for(let k=-14;k<=14;k++){const j=(hint+k+N)%N;
        const dx=this.x[j]-x,dy=this.y[j]-y,d=dx*dx+dy*dy;if(d<bd){bd=d;i=j;}}
      if(bd>(14*STEP)*(14*STEP)) i=-1;
    }
    if(i<0) i=this.nearest(x,y);
    if(i<0) i=0;
    let bs=0,bd=1e18,sd=0;
    for(let n=0;n<2;n++){
      const j=n===0?(i-1+N)%N:i, j2=(j+1)%N;
      const ax=this.x[j],ay=this.y[j],ex=this.x[j2]-ax,ey=this.y[j2]-ay;
      const L2=ex*ex+ey*ey,L=Math.sqrt(L2);
      let t=clamp(((x-ax)*ex+(y-ay)*ey)/L2,0,1);
      const px=ax+ex*t,py=ay+ey*t,dd=(x-px)*(x-px)+(y-py)*(y-py);
      if(dd<bd){bd=dd;bs=(j+t)*STEP;sd=(x-px)*(ey/L)-(y-py)*(ex/L);}
    }
    const idx=(((bs/STEP)|0)%N+N)%N;
    return {s:(bs%this.LEN+this.LEN)%this.LEN,d:sd,tx:this.tx[idx],ty:this.ty[idx],i:idx};
  }
  pos(s,d){
    const N=this.N;s=(s%this.LEN+this.LEN)%this.LEN;
    const f=s/STEP,i=f|0,t=f-i,j=(i+1)%N;
    const x=lerp(this.x[i],this.x[j],t),y=lerp(this.y[i],this.y[j],t);
    let tx=lerp(this.tx[i],this.tx[j],t),ty=lerp(this.ty[i],this.ty[j],t);
    const l=Math.hypot(tx,ty)||1;tx/=l;ty/=l;
    return {x:x+ty*d,y:y-tx*d,tx:tx,ty:ty};
  }
  idxOf(s){return ((((s/STEP)|0)%this.N)+this.N)%this.N;}
  lim(s){const i=this.idxOf(s);return {mx:this.mx[i],mn:this.mn[i]};}
}
/* --- geometry generators --- */
function ovalPts(){
  const S=2100,R=340,ARC=Math.PI*R,LEN=4*S+2*ARC,out=[],n=Math.round(LEN/STEP);
  for(let k=0;k<n;k++){
    const sr=LEN*k/n;
    if(sr<2*S) out.push({x:sr-S,y:-R});
    else if(sr<2*S+ARC){const p=(sr-2*S)/R-Math.PI/2;out.push({x:S+R*Math.cos(p),y:R*Math.sin(p)});}
    else if(sr<4*S+ARC) out.push({x:S-(sr-2*S-ARC),y:R});
    else{const q=Math.PI/2-(sr-4*S-ARC)/R;out.push({x:-S-R*Math.cos(q),y:R*Math.sin(q)});}
  }
  return out;
}
const ROAD_V=[[-2400,-900],[-250,-350],[1900,-900],[2750,-300],[2600,450],[1800,900],[700,1050],
  [564,550],[100,780],[-600,1030],[-1150,580],[-1700,1030],[-2294,1100],[-2650,620],[-3137,336],[-2850,-150]];
const ROAD_R=[210,420,300,300,300,420,202,165,420,300,210,420,300,420,210,420];
function roadPts(){
  const V=ROAD_V.map(p=>({x:p[0],y:p[1]})),n=V.length,turn=[],edge=[];
  for(let i=0;i<n;i++){
    const p=V[(i-1+n)%n],c=V[i],q=V[(i+1)%n];
