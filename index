    if(this.input.brake>0) a-=(vf>6?P.brake*gm:150*em)*this.input.brake;
    vf+=a*dt;
    vf-=(BASE.dragLin+ex)*vf*dt+BASE.dragQuad*vf*Math.abs(vf)*dt;
    this.vx=vf*ca;this.vy=vf*sa;
    this.x+=this.vx*dt;this.y+=this.vy*dt;
