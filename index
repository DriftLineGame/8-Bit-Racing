function fmt(t){if(t==null)return "--.---";
  const m=Math.floor(t/60),s=t-m*60;return (m>0?m+":"+(s<10?"0":""):"")+s.toFixed(3);}
function lapLogic(car){
  const s=car.info.s,d=s-car.prevS;
  if(d<-T.LEN/2){
    car.laps++;
    if(car.lapStart!=null&&car.lapValid){
      const t=G.time-car.lapStart;car.last=t;
      if(car.best==null||t<car.best){car.best=t;
        if(car.isPlayer)flash("NEW BEST  "+fmt(t),"#ffc23d",1400);}
      else if(car.isPlayer)flash(fmt(t),"#43e0ff",1000);
    }
    car.lapStart=G.time;car.lapValid=true;
    if(G.mode==="race"){
      if(car.laps>=G.totalLaps&&!car.finished){
        car.finished=true;car.finishTime=G.time;
        if(car.isPlayer)endRace();
      }else if(car.isPlayer&&car.laps===G.totalLaps-1)flash("FINAL LAP","#ff4d5a",1600);
    }
  }else if(d>T.LEN/2){car.laps--;car.lapStart=null;car.lapValid=false;}
