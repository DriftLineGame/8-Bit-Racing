}
// max speed a car can hold radius r at without running wide, given its steering
// authority (kinematic - no traction circle): v = r * steerMax*(1-steerFall*v/top), solved for v.
function vMaxKinematic(r,P){
  return (r*BASE.steerMax)/(1+r*BASE.steerMax*P.steerFall/P.top);
}
function lineProfile(T,d,P){
  const N=T.N,px=new Float64Array(N),py=new Float64Array(N),v=new Float64Array(N),ds=new Float64Array(N);
  for(let i=0;i<N;i++){const p=T.pos(i*STEP,d[i]);px[i]=p.x;py[i]=p.y;}
  for(let i=0;i<N;i++){const j=(i+1)%N;ds[i]=Math.hypot(px[j]-px[i],py[j]-py[i]);}
  const K=10;
  for(let i=0;i<N;i++){
    const a=(i-K+N)%N,c=(i+K)%N;
    const ab=Math.hypot(px[i]-px[a],py[i]-py[a]),bc=Math.hypot(px[c]-px[i],py[c]-py[i]),ca=Math.hypot(px[a]-px[c],py[a]-py[c]);
    const ar=Math.abs((px[i]-px[a])*(py[c]-py[a])-(px[c]-px[a])*(py[i]-py[a]))/2;
    const r=ar<1e-6?1e7:(ab*bc*ca)/(4*ar);
    v[i]=Math.min(P.top,vMaxKinematic(r,P)*0.95);
  }
  for(let p=0;p<6;p++){
    for(let i=N-1;i>=0;i--){const q=(i+1)%N;v[i]=Math.min(v[i],Math.sqrt(v[q]*v[q]+2*P.brake*0.85*ds[i]));}
    for(let i=0;i<N;i++){const q=(i-1+N)%N;v[i]=Math.min(v[i],Math.sqrt(v[q]*v[q]+2*P.accRef*ds[q]));}
  }
  return v;
}

