function editorScreenToWorld(px,py){
  return {x:(px-BW/2)/ED.zoom, y:(py-BH/2)/ED.zoom};
}
function editorWorldToScreen(x,y){
  return [BW/2+x*ED.zoom, BH/2+y*ED.zoom];
}
function editorPointerXY(e){
  const r=cvs.getBoundingClientRect();
  const px=(e.clientX-r.left)*(BW/r.width), py=(e.clientY-r.top)*(BH/r.height);
  return editorScreenToWorld(px,py);
}
