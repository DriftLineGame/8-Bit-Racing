const COL={void:"#080d0a",outg:"#16351f",grass:"#20512c",grass2:"#1c4726",
  road:"#3a3a46",road2:"#34343f",white:"#e8e8f0",kerb:"#c8342e",cone:"#ff8a3d"};
function offPath(g,off){
