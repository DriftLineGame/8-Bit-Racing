let last=performance.now(),acc=0;const FIXED=1/120;
function frame(now){
  requestAnimationFrame(frame);
  let dt=(now-last)/1000;last=now;if(dt>0.25)dt=0.25;
  if(G.state==="editor"){renderEditor();return;}
  if(G.state==="run"){acc+=dt;let n=0;
    while(acc>=FIXED&&n<8){tick(FIXED);acc-=FIXED;n++;}
    if(n>=8)acc=0;}
