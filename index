        this.vx-=1.30*vn*nx;this.vy-=1.30*vn*ny;
        if(vn>110){this.spin+=clamp(-this.vl*0.003,-1.3,1.3);
          Sound.thud(clamp(vn/420,0,1),false);spark(this.x,this.y,"#ffd36b",6);}
      }
      const sc=Math.pow(0.32,dt);this.vx*=sc;this.vy*=sc;
      const i2=T.info(this.x,this.y,this.hint);this.info=i2;this.hint=i2.i;
    }else this.info=i;
  }
  respawn(T){
    this.place(T,this.info.s,clamp(this.info.d,-T.TW*0.55,T.TW*0.55),Math.min(this.speed,95));
    this.wrong=0;this.stuck=0;this.lapValid=false;
  }
}
