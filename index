function buildTrack(){
  const W=Math.round((T.maxX-T.minX)*ZOOM),H=Math.round((T.maxY-T.minY)*ZOOM);
  const c=document.createElement("canvas");c.width=W;c.height=H;
  const g=c.getContext("2d");g.imageSmoothingEnabled=false;
  g.fillStyle=COL.void;g.fillRect(0,0,W,H);
  g.setTransform(ZOOM,0,0,ZOOM,-T.minX*ZOOM,-T.minY*ZOOM);
  const rx=()=>rnd(T.minX,T.maxX), ry=()=>rnd(T.minY,T.maxY);
  g.fillStyle=COL.outg;g.fillRect(T.minX,T.minY,T.maxX-T.minX,T.maxY-T.minY);
  g.fillStyle="rgba(0,0,0,.10)";
  for(let y=T.minY;y<T.maxY;y+=180)g.fillRect(T.minX,y,T.maxX-T.minX,90);
  g.fillStyle=COL.grass;offPath(g,T.BAR);g.fill();
  g.save();offPath(g,T.BAR);g.clip();
  g.fillStyle=COL.grass2;for(let i=0;i<2600;i++)g.fillRect(Math.round(rx()),Math.round(ry()),4,2);
  g.restore();
  g.fillStyle=COL.void;offPath(g,-T.BAR);g.fill();
  g.fillStyle=COL.road;offPath(g,T.TW);g.fill();
  g.fillStyle=COL.grass;offPath(g,-T.TW);g.fill();
  g.save();offPath(g,T.TW);g.clip();
  g.fillStyle=COL.road2;for(let i=0;i<9000;i++)g.fillRect(Math.round(rx()),Math.round(ry()),4,2);
  g.restore();
  g.fillStyle=COL.grass;offPath(g,-T.TW);g.fill();
  g.strokeStyle=COL.white;g.lineWidth=6;
  offPath(g,T.TW-3);g.stroke();offPath(g,-(T.TW-3));g.stroke();
  // kerbs wherever the track actually bends
  const quad=(p1,p2,p3,p4,col)=>{g.fillStyle=col;g.beginPath();g.moveTo(p1.x,p1.y);g.lineTo(p2.x,p2.y);
    g.lineTo(p3.x,p3.y);g.lineTo(p4.x,p4.y);g.closePath();g.fill();};
  const KS=Math.round(44/STEP);
  for(let i=0;i<T.N;i+=KS){
    if(T.rad[i]>900)continue;
    const j=Math.min(i+KS,T.N);
    const col=((i/KS)|0)%2===0?COL.kerb:COL.white;
    for(const sgn of [1,-1]){
      const o1=sgn*(T.TW-4),o2=sgn*(T.TW-26);
      quad(T.pos(i*STEP,o1),T.pos(j*STEP,o1),T.pos(j*STEP,o2),T.pos(i*STEP,o2),col);
    }
  }
  // cones just off the edge through the slowest corners
  for(let i=0;i<T.N;i+=Math.round(96/STEP)){
    if(T.rad[i]>460)continue;
    for(const sgn of [1,-1]){
      const p=T.pos(i*STEP,sgn*(T.TW+16));
      g.fillStyle="rgba(0,0,0,.35)";g.fillRect(p.x-7,p.y+5,14,3);
      g.fillStyle=COL.cone;g.fillRect(p.x-6,p.y-6,12,12);
      g.fillStyle=COL.white;g.fillRect(p.x-6,p.y-2,12,4);
    }
  }
  // start / finish
  for(let r=0;r<2;r++)for(let k=0;k<10;k++){
    const d1=-T.TW+k*(2*T.TW/10),d2=-T.TW+(k+1)*(2*T.TW/10);
    quad(T.pos(r*15,d1),T.pos(r*15+15,d1),T.pos(r*15+15,d2),T.pos(r*15,d2),
      ((k+r)%2===0)?COL.white:"#171720");
  }
  quad(T.pos(-8,-T.TW),T.pos(-5,-T.TW),T.pos(-5,T.TW),T.pos(-8,T.TW),COL.white);
  g.strokeStyle="rgba(232,232,240,.7)";g.lineWidth=3;
  for(let i=0;i<11;i++){
    const gp=gridSlot(i),p=T.pos(gp.s,gp.d);
    g.save();g.translate(p.x,p.y);g.rotate(Math.atan2(p.ty,p.tx));g.strokeRect(-30,-22,60,44);g.restore();
  }
  g.lineWidth=14;g.setLineDash([]);
  g.strokeStyle=COL.white;offPath(g,T.BAR);g.stroke();offPath(g,-T.BAR);g.stroke();
  g.strokeStyle=COL.kerb;g.setLineDash([34,34]);
  offPath(g,T.BAR);g.stroke();offPath(g,-T.BAR);g.stroke();
  g.setLineDash([]);g.lineWidth=3;g.strokeStyle="rgba(0,0,0,.45)";
  offPath(g,T.BAR-8);g.stroke();offPath(g,-(T.BAR-8));g.stroke();
  trackCanvas=c;
}
