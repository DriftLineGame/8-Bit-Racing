    if(held){this.vx*=0.82;this.vy*=0.82;this.speed=Math.hypot(this.vx,this.vy);this.vf=0;this.vl=0;return;}
    const P=this.P;
    const sp=Math.hypot(this.vx,this.vy);
    const on=Math.abs(this.info.d)>T.TW;this.onGrass=on;
    const gm=on?BASE.grassGrip:1, em=on?BASE.grassEng:1, ex=on?BASE.grassDrag:0;
    // pure kinematic steering: turning costs no speed on its own. Turn rate falls off with
    // speed (steerFall, per-car) - so at high speed you simply can't turn tight enough for a
    // given corner, and run wide onto the grass unless you brake first.
    const dir=(this.vf<-5)?-1:1;
    const ramp=clamp(sp/40,0,1);
