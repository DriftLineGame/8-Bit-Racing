bindEditBtn("eSave",()=>{
  if(!ED.valid)return;
  const nm=(prompt("NAME THIS TRACK")||"").trim().slice(0,16);
  if(!nm)return;
  const list=customTrackList();
  list.push({name:nm,V:ED.V.slice()});
  saveCustomTrackList(list);
  G.customTrack={name:nm,V:ED.V.slice(),pts:ED.builtPts};
  exitEditor();
  flash("SAVED","#5be07a",1200);
  trackMenu(ED.raceAfter!==undefined?ED.raceAfter:false);
});
bindEditBtn("eExit",()=>{exitEditor();ED.raceAfter!==undefined?trackListMenu(ED.raceAfter):menu();});

addEventListener("pointerdown",()=>Sound.init());
resize();
T=new Track(ovalPts(),125,90,0,"oval","OVAL");
LD=optLine(T,0.1,14);VP=lineProfile(T,LD,CLASSES[G.cls]);buildTrack();
G.player=playerCar();G.player.place(T,T.LEN-170,0,0);
G.cars=[G.player];G.cam.x=G.player.x;G.cam.y=G.player.y;
menu();
requestAnimationFrame(frame);
</script>
