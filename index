  for(let i=parts.length-1;i>=0;i--){const p=parts[i];
    p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=0.94;p.vy*=0.94;
    if(p.life<=0)parts.splice(i,1);}
  render();
  if(G.state!=="menu")updateHUD();
}
function tick(dt){
  G.time+=dt;
  if(G.holding){
    G.lightT-=dt;
    if(G.lightT<=0){
      if(G.lights<5){G.lights++;G.lightT=0.95;Sound.beep(520,0.12,0.22);
        const ls=document.querySelectorAll("#lights .light");
        for(let i=0;i<5;i++)ls[i].classList.toggle("lit",i<G.lights);}
      else{G.holding=false;G.goTime=G.time;Sound.beep(880,0.30,0.26);
        document.querySelectorAll("#lights .light").forEach(l=>l.classList.remove("lit"));
        el("lights").classList.remove("on");flash("GO GO GO","#5be07a",1100);}
    }
  }
  const raceT=G.mode==="race"?G.time-G.goTime:99;
  const laneHold=G.mode==="race"?clamp((raceT-2.6)/3.4,0,1):1;
  const calm=(G.mode==="race"&&raceT<5)?0.4:1;
  const pin=readInput();
  G.player.input.steer=pin.steer;G.player.input.throttle=pin.throttle;G.player.input.brake=pin.brake;
  for(const c of G.cars)if(!c.isPlayer){
    aiThink(c,dt,G.cars,laneHold,T,LD,VP);
    if(!G.holding&&raceT<c.react){c.input.throttle=0;c.input.brake=0;}
  }
  for(const c of G.cars)c.step(dt,G.holding,T);
  const RAD=20;
  for(let i=0;i<G.cars.length;i++)for(let j=i+1;j<G.cars.length;j++){
    const a=G.cars[i],b=G.cars[j];
    const dx=b.x-a.x,dy=b.y-a.y,d2=dx*dx+dy*dy,md=RAD*2;
    if(d2<md*md&&d2>1e-6){
      const d=Math.sqrt(d2),nx=dx/d,ny=dy/d,ov=md-d;
      a.x-=nx*ov*0.52;a.y-=ny*ov*0.52;b.x+=nx*ov*0.52;b.y+=ny*ov*0.52;
      const rvx=b.vx-a.vx,rvy=b.vy-a.vy,vn=rvx*nx+rvy*ny;
      if(vn<0){
        const imp=-1.02*vn*0.5*calm;
        a.vx-=imp*nx;a.vy-=imp*ny;b.vx+=imp*nx;b.vy+=imp*ny;
        if(-vn>95){const tg=(-rvx*ny+rvy*nx)*calm;
          a.spin+=clamp(tg*0.0009,-.55,.55);b.spin-=clamp(tg*0.0009,-.55,.55);
          Sound.thud(clamp(-vn/380,0,1),false);spark((a.x+b.x)/2,(a.y+b.y)/2,"#ffd36b",5);}
        else if(-vn>25)Sound.thud(0.10,true);
      }
    }
  }
  for(const c of G.cars){
    c.walls(dt,T);lapLogic(c);
    const fwd=c.vx*c.info.tx+c.vy*c.info.ty;
    if(fwd<-25&&!G.holding)c.wrong+=dt;else c.wrong=Math.max(0,c.wrong-dt*1.6);
    if(c.speed<22&&Math.abs(c.info.d)>T.TW&&!G.holding)c.stuck+=dt;else c.stuck=Math.max(0,c.stuck-dt);
    if(c.wrong>1.7||c.stuck>3.2)c.respawn(T);
    if(c.onGrass&&c.speed>60&&Math.random()<0.5)dust(c.x-c.vx*0.03,c.y-c.vy*0.03,"#2e6b3a");
    if(c.slip>0.35&&c.speed>150&&Math.random()<0.35)dust(c.x,c.y,"#4a4a58");
  }
  el("warn").classList.toggle("on",G.player.wrong>0.4);
  const p=G.player,k=Math.min(1,dt*7);
  G.cam.x+=(p.x+p.vx*0.36-G.cam.x)*k;G.cam.y+=(p.y+p.vy*0.36-G.cam.y)*k;
  audioTick();
}
function audioTick(){
  if(!Sound.ready)return;
  const p=G.player,C=p.P,gi=gearInfo(p.vf,C.top);
  if(gi.gear<p.gear && p.speed>90) Sound.crackle(C.snd.crack);
  else if(gi.gear>p.gear) Sound.crackle(C.snd.crack*0.25);
  p.gear=gi.gear;
  let rpm=gi.rpm;
  if(G.holding||p.speed<25){p.revBlend+=((p.input.throttle?0.95:0.14)-p.revBlend)*0.10;rpm=p.revBlend;}
  if(!p.input.throttle&&p.speed>200&&Math.random()<0.012) Sound.crackle(C.snd.crack*0.5);
  const load=p.input.throttle?1:(p.input.brake?0.15:0.35);
  Sound.engine(Sound.eng,rpm,load,0.55+0.45*(p.input.throttle?1:0.45),C.snd);
  let near=null,bd=1e9;
  for(const c of G.cars)if(c!==p){const d=Math.hypot(c.x-p.x,c.y-p.y);if(d<bd){bd=d;near=c;}}
  if(near&&bd<900)Sound.engine(Sound.rival,gearInfo(near.vf,C.top).rpm,near.input.throttle,clamp(1-bd/900,0,1),C.snd);
  else Sound.engine(Sound.rival,0.2,0,0,C.snd);
  Sound.set(Sound.skid,clamp(p.slip*0.55,0,0.34)+(p.input.brake&&p.speed>200?0.10:0));
  Sound.set(Sound.gravel,p.onGrass?clamp(p.speed/420,0,1)*0.30:0);
}
function render(){
  ctx.fillStyle="#080d0a";ctx.fillRect(0,0,BW,BH);
  if(!trackCanvas||!T)return;
  const camX=clamp(G.cam.x,T.minX+BW/ZOOM/2,T.maxX-BW/ZOOM/2);
  const camY=clamp(G.cam.y,T.minY+BH/ZOOM/2,T.maxY-BH/ZOOM/2);
  const sx=Math.round((camX-T.minX)*ZOOM-BW/2),sy=Math.round((camY-T.minY)*ZOOM-BH/2);
  ctx.drawImage(trackCanvas,sx,sy,BW,BH,0,0,BW,BH);
  const wx=x=>(x-T.minX)*ZOOM-sx, wy=y=>(y-T.minY)*ZOOM-sy;
  for(const p of parts){
    const a=wx(p.x),b=wy(p.y);
    if(a<-8||b<-8||a>BW+8||b>BH+8)continue;
    ctx.globalAlpha=clamp(p.life*2,0,1);ctx.fillStyle=p.col;
    ctx.fillRect(Math.round(a),Math.round(b),p.sz,p.sz);
  }
  ctx.globalAlpha=1;
  for(const c of G.cars){
    const a=wx(c.x),b=wy(c.y);
    if(a<-40||b<-40||a>BW+40||b>BH+40)continue;
    const px=Math.round(a),py=Math.round(b);
    ctx.save();ctx.translate(px,py);ctx.rotate(c.angle);
    ctx.globalAlpha=.35;ctx.fillStyle="#000";ctx.fillRect(-11,-6,24,14);
    ctx.globalAlpha=1;ctx.drawImage(c.sprite,-13,-8);ctx.restore();
    if(c.isPlayer){ctx.fillStyle="#ffc23d";
      ctx.fillRect(px-3,py-17,6,2);ctx.fillRect(px-1,py-15,2,2);}
  }
  drawMap();
}
function drawMap(){
  const w=mapC.width,h=mapC.height;mapX.clearRect(0,0,w,h);
  if(!T)return;
  const sc=Math.min((w-8)/(T.maxX-T.minX),(h-8)/(T.maxY-T.minY));
  const ox=w/2-((T.minX+T.maxX)/2)*sc, oy=h/2-((T.minY+T.maxY)/2)*sc;
  mapX.save();mapX.translate(ox,oy);mapX.scale(sc,sc);
  mapX.strokeStyle="#5c6a8f";mapX.lineWidth=2*T.TW+40;
  mapX.beginPath();
  for(let i=0;i<=T.N;i+=2){const j=i%T.N;if(i===0)mapX.moveTo(T.x[j],T.y[j]);else mapX.lineTo(T.x[j],T.y[j]);}
  mapX.closePath();mapX.stroke();
  mapX.strokeStyle="#3a3a46";mapX.lineWidth=2*T.TW;mapX.stroke();
  mapX.restore();
  for(const c of G.cars){
    const s=c.isPlayer?4:3;
    mapX.fillStyle=c.isPlayer?"#ffc23d":c.colour;
    mapX.fillRect(Math.round(ox+c.x*sc)-(s>>1),Math.round(oy+c.y*sc)-(s>>1),s,s);
  }
  const f=T.pos(0,0);
  mapX.fillStyle="#e8e8f0";mapX.fillRect(Math.round(ox+f.x*sc)-1,Math.round(oy+f.y*sc)-2,2,4);
}
