function renderEditor(){
  ctx.fillStyle="#0a0e18";ctx.fillRect(0,0,BW,BH);
  ctx.strokeStyle="rgba(67,224,255,.10)";ctx.lineWidth=1;
  const grid=400*ED.zoom;
  const ox=(BW/2)%grid, oy=(BH/2)%grid;
  ctx.beginPath();
  for(let x=ox;x<BW;x+=grid){ctx.moveTo(x,0);ctx.lineTo(x,BH);}
  for(let y=oy;y<BH;y+=grid){ctx.moveTo(0,y);ctx.lineTo(BW,y);}
  ctx.stroke();
  const [cx,cy]=editorWorldToScreen(0,0);
  ctx.fillStyle="rgba(255,194,61,.4)";ctx.fillRect(cx-2,cy-2,4,4);

  if(ED.valid&&ED.builtPts){
    ctx.strokeStyle="rgba(91,224,122,.9)";ctx.lineWidth=CUSTOM_TW*2*ED.zoom;
    ctx.lineJoin="round";ctx.beginPath();
    for(let i=0;i<=ED.builtPts.length;i++){
      const p=ED.builtPts[i%ED.builtPts.length];
      const [sx,sy]=editorWorldToScreen(p.x,p.y);
      i===0?ctx.moveTo(sx,sy):ctx.lineTo(sx,sy);
    }
    ctx.stroke();
  }
  if(ED.V.length>1){
    ctx.strokeStyle=ED.valid?"rgba(232,232,240,.5)":"rgba(255,77,90,.6)";
    ctx.lineWidth=2;ctx.setLineDash(ED.valid?[]:[6,5]);
    ctx.beginPath();
    for(let i=0;i<ED.V.length;i++){
      const [sx,sy]=editorWorldToScreen(ED.V[i].x,ED.V[i].y);
      i===0?ctx.moveTo(sx,sy):ctx.lineTo(sx,sy);
    }
    if(ED.V.length>=3){const [sx,sy]=editorWorldToScreen(ED.V[0].x,ED.V[0].y);ctx.lineTo(sx,sy);}
    ctx.stroke();ctx.setLineDash([]);
  }
  ED.V.forEach((p,i)=>{
    const [sx,sy]=editorWorldToScreen(p.x,p.y);
    ctx.fillStyle=i===0?"#ffc23d":"#43e0ff";
    ctx.beginPath();ctx.arc(sx,sy,i===0?6:4,0,7);ctx.fill();
  });
}
