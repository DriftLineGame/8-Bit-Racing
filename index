/* ===================== TRACK EDITOR ===================== */
const CUSTOM_TW=100, CUSTOM_GRW=68;
function segInt(p1,p2,p3,p4){
  const d1x=p2.x-p1.x,d1y=p2.y-p1.y,d2x=p4.x-p3.x,d2y=p4.y-p3.y;
  const den=d1x*d2y-d1y*d2x; if(Math.abs(den)<1e-9)return false;
  const t=((p3.x-p1.x)*d2y-(p3.y-p1.y)*d2x)/den, u=((p3.x-p1.x)*d1y-(p3.y-p1.y)*d1x)/den;
  return t>0.001&&t<0.999&&u>0.001&&u<0.999;
}
function polySimple(V){
  const n=V.length; if(n<4) return false;
  for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){
    if(j===i||j===(i+1)%n||i===(j+1)%n)continue;
    if(segInt(V[i],V[(i+1)%n],V[j],V[(j+1)%n])) return false;
  }
  return true;
}
function autoFillet(V,tw){
  const n=V.length,turn=[],edge=[];
  for(let i=0;i<n;i++){
    const p=V[(i-1+n)%n],c=V[i],q=V[(i+1)%n];
    turn[i]=angNorm(Math.atan2(q.y-c.y,q.x-c.x)-Math.atan2(c.y-p.y,c.x-p.x));
    edge[i]=Math.hypot(q.x-c.x,q.y-c.y);
  }
  const RMIN=tw*1.6, RMAX=tw*7;
  let r=turn.map(()=>RMAX);
  for(let it=0;it<3000;it++){let bad=false;
    for(let i=0;i<n;i++){const j=(i+1)%n;
      const ti=r[i]*Math.tan(Math.abs(turn[i])/2), tj=r[j]*Math.tan(Math.abs(turn[j])/2);
      if(edge[i]-ti-tj-Math.max(20,tw*0.4)<0){bad=true;
        if(r[i]>RMIN)r[i]*=0.99; if(r[j]>RMIN)r[j]*=0.99;
      }}
    if(!bad)break;
  }
  const t=r.map((rr,i)=>rr*Math.tan(Math.abs(turn[i])/2));
  const st=edge.map((e,i)=>e-t[i]-t[(i+1)%n]);
  const feasible=st.every(x=>x>4)&&r.every(x=>x>=RMIN-2);
  return {r,turn,edge,t,st,feasible};
}
function buildFromVertices(V,tw){
  const A=autoFillet(V,tw);
  if(!A.feasible) return null;
  const n=V.length,pts=[];
  for(let i=0;i<n;i++){
    const c=V[i],q=V[(i+1)%n],j=(i+1)%n;
    const dx=(q.x-c.x)/A.edge[i],dy=(q.y-c.y)/A.edge[i];
    const ax=c.x+dx*A.t[i],ay=c.y+dy*A.t[i],bx=q.x-dx*A.t[j],by=q.y-dy*A.t[j];
    const L=Math.hypot(bx-ax,by-ay),m=Math.max(1,Math.round(L/STEP));
    for(let k=0;k<m;k++) pts.push({x:ax+(bx-ax)*k/m,y:ay+(by-ay)*k/m});
    const th=A.turn[j],sg=Math.sign(th),rr=A.r[j],hIn=Math.atan2(dy,dx);
    const cx=bx+Math.cos(hIn+sg*Math.PI/2)*rr, cy=by+Math.sin(hIn+sg*Math.PI/2)*rr;
    const a0=Math.atan2(by-cy,bx-cx), ma=Math.max(2,Math.round(Math.abs(th)*rr/STEP));
    for(let k=0;k<ma;k++){const a=a0+th*k/ma;pts.push({x:cx+rr*Math.cos(a),y:cy+rr*Math.sin(a)});}
  }
  return pts;
}
function trackSelfClearance(pts){
  let self=1e9;
  for(let i=0;i<pts.length;i+=2)for(let j=i+60;j<pts.length;j+=2){
    if(Math.min(j-i,pts.length-(j-i))<60)continue;
    const d=Math.hypot(pts[i].x-pts[j].x,pts[i].y-pts[j].y);if(d<self)self=d;
  }
  return self;
}
// full validation pipeline: returns {ok,reason} or {ok:true,pts}
function validateCustomTrack(V){
  if(V.length<5) return {ok:false,reason:"NEEDS AT LEAST 5 POINTS"};
  const n=V.length;
  for(let i=0;i<n;i++){
    const j=(i+1)%n, d=Math.hypot(V[j].x-V[i].x,V[j].y-V[i].y);
    if(d<180) return {ok:false,reason:"TWO POINTS ARE TOO CLOSE TOGETHER"};
  }
  if(!polySimple(V)) return {ok:false,reason:"TRACK CROSSES ITSELF"};
  const pts=buildFromVertices(V,CUSTOM_TW);
  if(!pts) return {ok:false,reason:"CORNERS TOO SHARP FOR THE GAPS BETWEEN POINTS"};
  const clr=trackSelfClearance(pts);
  if(clr<2*(CUSTOM_TW+CUSTOM_GRW)*1.02) return {ok:false,reason:"TRACK LOOPS BACK TOO CLOSE TO ITSELF"};
  return {ok:true,pts};
}
