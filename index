/* ===================== AI ===================== */
function aiThink(car,dt,cars,laneHold,T,LD,VP){
  const I=car.info,sp=car.speed,N=T.N;
  let vT=VP[(T.idxOf(I.s)+2)%N]*car.skill;
  const la=Math.max(95,sp*0.52);
  let lineD=LD[T.idxOf(I.s+la)]+car.bias;
  if(laneHold<1) lineD=lerp(car.startD,lineD,laneHold);
  const reach=laneHold<1?360:280;
  let targetD=lineD,brakeExtra=0,block=null,gap=1e9;
  for(const o of cars){
    if(o===car)continue;
    let dd=o.info.s-I.s;
    if(dd>T.LEN/2)dd-=T.LEN;else if(dd<-T.LEN/2)dd+=T.LEN;
    const lat=o.info.d-I.d;
    if(dd>0&&dd<reach&&Math.abs(lat)<72&&dd<gap){gap=dd;block=o;}
    if(Math.abs(dd)<62&&Math.abs(lat)<52) targetD+=(lat>0?-1:1)*36;
  }
  if(block){
    let side=(I.d>=block.info.d)?1:-1;
    let want=block.info.d+side*84;
    if(Math.abs(want)>T.TW-40) want=block.info.d-side*84;
    want=clamp(want,-(T.TW-40),T.TW-40);
    targetD=lerp(targetD,want,clamp(1-gap/reach,0,1)*0.9);
    const near=laneHold<1?175:125;
    if(gap<near){
      const cl=sp-block.speed;
      if(cl>0) brakeExtra=clamp(cl/34,0,1)*clamp(1-gap/near,0,1);
      vT=Math.min(vT,block.speed+(laneHold<1?18:45));
    }
  }
  const LM=T.lim(I.s+la);
  targetD=clamp(targetD,Math.max(LM.mn+18,-(T.TW-14)),Math.min(LM.mx-18,T.TW-14));
  car.aimD+=(targetD-car.aimD)*Math.min(1,dt*6);
  const tp=T.pos(I.s+la,car.aimD);
  const err=angNorm(Math.atan2(tp.y-car.y,tp.x-car.x)-car.angle);
  let steer=clamp(err*2.8,-1,1),thr=0,brk=0;
  if(Math.abs(err)>2.0&&sp<70){brk=1;steer=-steer;}
  else if(sp<vT) thr=1;
  else if(sp>vT+5) brk=clamp((sp-vT)/25,0,1);
  brk=Math.max(brk,brakeExtra);
  if(brk>0.06) thr=0;
  if(car.onGrass){thr=Math.max(thr,0.6);brk=0;}
  car.input.steer=steer;car.input.throttle=thr;car.input.brake=brk;
}

